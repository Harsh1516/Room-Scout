# ==============================================================================
# RoomScout Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and adjust values for your environment:
#   cp .env.example .env
#
# IMPORTANT SECURITY NOTE:
# Only variables prefixed with 'VITE_' are bundled and exposed to the browser client!
# NEVER put private server secrets, database URIs, or admin API keys in frontend .env!
# ==============================================================================

# Backend API Base URL
# Development: http://localhost:5000/api
# Production (Render): https://roomscout-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Google OAuth Client ID (optional, for Google Sign-In)
VITE_GOOGLE_CLIENT_ID=206140766993-caova3o2u7mf54osrklq1d31p3ktq9v2.apps.googleusercontent.com
