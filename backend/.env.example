# ==============================================================================
# RoomScout Backend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your values:
#   cp .env.example .env
#
# SECURITY WARNING:
# NEVER commit your real '.env' file or private credentials to Git version control.
# In production, use your hosting platform's secrets manager (e.g. Render, AWS, Vercel).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Core Configuration
# ------------------------------------------------------------------------------
# Environment mode: 'development' | 'production' | 'test'
NODE_ENV=development

# Server port to listen on (default: 5000)
PORT=5000

# Client origin(s) permitted by CORS (comma-separated list)
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Reverse Proxy Trust Configuration:
# Set to '1' when behind a single proxy (Render, Vercel, Nginx),
# or 'loopback, linklocal, uniquelocal' for multi-hop cloud VPC / Cloudflare setups.
TRUST_PROXY=1

# ------------------------------------------------------------------------------
# 2. Database (MongoDB)
# ------------------------------------------------------------------------------
# Standard MongoDB connection string (must begin with 'mongodb://' or 'mongodb+srv://')
# Local example:  mongodb://127.0.0.1:27017/roomscout
# Atlas example:  mongodb+srv://<db_user>:<db_pass>@cluster0.mongodb.net/roomscout?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/roomscout

# ------------------------------------------------------------------------------
# 3. Cryptography & Authentication (JWT & Admin Access)
# ------------------------------------------------------------------------------
# Cryptographic secret key used to sign and verify JSON Web Tokens.
# In production, this MUST be at least 32 characters long.
# Generate a cryptographically secure key:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_characters_long

# Master administrative secret key for administrative automation and master dashboard
ADMIN_KEY=replace_with_a_secure_admin_master_key

# ------------------------------------------------------------------------------
# 4. Payment Gateway (Razorpay)
# ------------------------------------------------------------------------------
# If left empty, the server operates in Razorpay Sandbox simulation mode.
# Obtain keys from your Razorpay Dashboard: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 5. Media Asset Storage (Cloudinary)
# ------------------------------------------------------------------------------
# Required for hosting uploaded property photographs and guest room media.
# Obtain credentials from Cloudinary Console: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 6. Distributed Cache & Rate Limiting (Redis - Optional)
# ------------------------------------------------------------------------------
# If REDIS_URL is provided, rate limiting and caching synchronize across containers.
# If left blank, the application automatically falls back to in-memory storage.
# Examples:
#   Local:   redis://127.0.0.1:6379
#   Upstash: rediss://default:<token>@<host>.upstash.io:6379
REDIS_URL=

# ------------------------------------------------------------------------------
# 7. SMTP Email Service (Nodemailer - Optional)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password_here
EMAIL_FROM="RoomScout Support" <noreply@roomscout.io>
